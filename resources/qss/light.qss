QMessageBox {
    font: 11pt "Roboto";
    border-radius: 4px;
    padding: 4px;
}

QMessageBox QPushButton {
    padding-left: 20px;
    padding-right: 20px;
}

QWidget {
    background-color: #fafafa;
    color: #202020;
}

QPushButton {
    border-radius: 4px;

    border-left: 1px solid #c1c1c1;
    border-top: 1px solid #c1c1c1;
    border-right: 1px solid #c1c1c1;
    border-bottom: 1px solid #a8a8a8;

    padding: 4px 8px;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, 
                                stop: 0 #f6f7fa, stop: 1 #cccccc);
    color: black;
}

QPushButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, 
                                stop: 0 #ffffff,
                                stop: 1 #dddddd);
    
    border-left: 1px solid #F7AA5C; 
    border-top: 1px solid #F7AA5C;
    border-right: 1px solid #C66B0D;
    border-bottom: 1px solid #C66B0D;
    
    color: black;
    border-radius: 4px;
}

QPushButton:pressed {
    border-left: 1px solid #a8a8a8;
    border-top: 1px solid #a8a8a8;
    border-right: 1px solid #c1c1c1;
    border-bottom: 1px solid #c1c1c1;
    
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, 
                                stop: 0 #cccccc, stop: 1 #f6f7fa);
    
    padding: 5px 7px 3px 9px;
    
    color: black;
    border-radius: 4px;
}

QPushButton:disabled {
    background-color: #e5e5e5;    
    border: 1px solid #d0d0d0;
    color: #a0a0a0;
    border-radius: 4px;
}

QLineEdit, #tagLineEdit {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, 
                                stop: 0 #cccccc,
                                stop: 1 #f6f7fa);
    
    border-radius: 4px;
    padding: 3px 5px;
    color: black;
    
    border-left: 1px solid #a8a8a8; 
    border-top: 1px solid #a8a8a8;
    border-right: 1px solid #d0d0d0;
    border-bottom: 1px solid #d0d0d0;    
}

QLineEdit:focus, #tagLineEdit:focus {
    border: 1px solid #F7AA5C; 
    background-color: #ffffff; 
    border-radius: 4px; 
    padding: 3px 5px;
}

PlainTextEdit, QTextEdit {
    background-color: #F5F5F5;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 16px;
    height: 16px;
    image: url(:/icons/unchecked.png);     
    background: transparent; 
    border: none;
}

QRadioButton::indicator:checked, QCheckBox::indicator::checked {
    image: url(:/icons/checked.png); 
}

QRadioButton::indicator:hover {
    image: url(:/icons/hover_unchecked.png);
}

QRadioButton::indicator:!checked:hover {
    image: url(:/icons/hover_unchecked.png);
}

QRadioButton::indicator:checked:hover {
    image: url(:/icons/checked.png);
}

QMenu {
    font: 11pt "Roboto";
    border: 1px solid #CCCCCC;   
    background-color: #F0F0F0; 
    border-radius: 4px;    
    padding: 4px;
}

QMenu::item {
    padding: 3px 20px 3px 10px; 
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #3399FF;
    color: white;
    border-radius: 2px;
}

ResultsTable,
ResultsTable QHeaderView {
    font: 11pt "Roboto";
}

ResultsTable QHeaderView::section {
    border: none;

    border-right: 1px solid #c1c1c1;
    border-bottom: 1px solid #a8a8a8;

    padding: 4px;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, 
                                stop: 0 #f6f7fa, stop: 1 #cccccc);
    color: black;
}

ResultsTable QHeaderView[show-last-border="true"]::section:last {
    border-right: 1px solid #c1c1c1; 
}

ResultsTable QHeaderView[show-last-border="false"]::section:last {
    border-right: none;
}

QTableWidget::item:selected:!active {
    background: transparent;
    color: inherit;
}

QScrollBar:vertical, QScrollBar:horizontal {    
    background: #ebebeb;
    width: 12px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #cacaca;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
}

QToolButton {
    border: none;
    padding-bottom: 4px;
    padding-right: 8px;
}

QToolButton::menu-indicator {
    image: none;
}

#checkFilePath {
    color: #E05C2A;
}

QToolBar#ResourceViewerToolbar QToolButton {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
    background-color: transparent;
}

QToolBar#ResourceViewerToolbar ToolButton:hover {
    background-color: rgba(128, 128, 128, 15%); 
    border: 1px solid #F7AA5C;
}

QToolBar#ResourceViewerToolbar QToolButton:pressed {
    background-color: rgba(0, 0, 0, 15%);
    padding-left: 3px;
    padding-top: 3px;
}

QToolBar#ResourceViewerToolbar QToolButton:checked {
    background-color: rgba(0, 120, 215, 20%);
    border: 1px solid rgba(0, 120, 215, 40%);
}

QToolBar#ResourceViewerToolbar QToolButton:checked:hover {
    background-color: rgba(0, 120, 215, 30%);
}