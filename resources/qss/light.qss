QMessageBox {
    font: 11pt "Roboto";
    border-radius: 4px;
    padding: 4px;
}

QMessageBox QPushButton {
    padding-left: 20px;
    padding-right: 20px;
}

QWidget {
    background-color: #fafafa;
    color: #202020;
}

QPushButton {
    background-color: #e0e0e0;
    border-radius: 4px;
    padding: 4px 8px;
    border: 1px solid #b3b3b3;
}

QPushButton:hover {
    background-color: #d0d0d0;
}

QPushButton:disabled {
    background-color: #dddddd;
    border: 1px solid #c0c0c0;
    color: #a0a0a0;
}

QLineEdit {
    border: 1px solid #b3b3b3;
    padding: 3px 4px;
    border-radius: 4px;
}

#tagLineEdit {
    background-color: #fafafa;
    border: 1px solid #b3b3b3;
    padding: 4px 4px;
    border-radius: 4px;
}

PlainTextEdit, QTextEdit {
    background-color: #F5F5F5;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    image: url(:/icons/unchecked.png);     
    background: transparent; 
    border: none;
}

QRadioButton::indicator:checked {
    image: url(:/icons/checked.png); 
}

QRadioButton::indicator:hover {
    image: url(:/icons/hover_unchecked.png);
}

QRadioButton::indicator:!checked:hover {
    image: url(:/icons/hover_unchecked.png);
}

QRadioButton::indicator:checked:hover {
    image: url(:/icons/checked.png);
}

QMenu {
    font: 11pt "Roboto";
    border: 1px solid #CCCCCC;   
    background-color: #F0F0F0; 
    border-radius: 4px;    
    padding: 4px;
}

QMenu::item {
    padding: 3px 20px 3px 10px; 
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #3399FF;
    color: white;
    border-radius: 2px;
}

ResultsTable,
ResultsTable QHeaderView {
    font: 11pt "Roboto";
}

ResultsTable QHeaderView::section {
    border: none;

    border-right: 1px solid #c1c1c1;
    border-bottom: 1px solid #a8a8a8;

    padding: 4px;
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, 
                                stop: 0 #f6f7fa, stop: 1 #cccccc);
    color: black;
}

ResultsTable QHeaderView[show-last-border="true"]::section:last {
    border-right: 1px solid #c1c1c1; 
}

ResultsTable QHeaderView[show-last-border="false"]::section:last {
    border-right: none;
}

QTableWidget::item:selected:!active {
    background: transparent;
    color: inherit;
}

QScrollBar:vertical, QScrollBar:horizontal {    
    background: #ebebeb;
    width: 12px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #cacaca;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
}

QToolButton {
    border: none;
    padding-bottom: 4px;
    padding-right: 8px;
}

QToolButton::menu-indicator {
    image: none;
}

#checkFilePath {
    color: #E05C2A;
}
