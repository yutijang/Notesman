{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER_LAUNCHER": "sccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
            },
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "windows-clang-base",
            "hidden": true,
            "inherits": [
                "base"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_LINKER": "lld-link",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "environment": {
                "VCPKG_ROOT": "D:/cpp/vcpkg"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-clang-base",
            "hidden": true,
            "inherits": [
                "base"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_LINKER": "lld",
                "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++",
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -fuse-ld=lld",
                "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -fuse-ld=lld"
            },
            "environment": {
                "VCPKG_ROOT": "/mnt/CPPDATA/vcpkg"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-debug",
            "inherits": [
                "windows-clang-base"
            ],
            "displayName": "Windows Clang-CL Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL"
            }
        },
        {
            "name": "windows-release",
            "inherits": [
                "windows-clang-base"
            ],
            "displayName": "Windows Clang-CL Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "OFF",
                "CMAKE_CXX_FLAGS_RELEASE": "/O2",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
            }
        },
        {
            "name": "linux-debug",
            "inherits": [
                "linux-clang-base"
            ],
            "displayName": "Linux Clang++ Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "linux-release",
            "inherits": [
                "linux-clang-base"
            ],
            "displayName": "Linux Clang++ Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "OFF",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3"
            }
        },
        {
            "name": "linux-asan",
            "inherits": [
                "linux-clang-base"
            ],
            "displayName": "Linux Clang++ ASan (app only)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++ -fsanitize=address -fno-omit-frame-pointer -O1 -g",
                "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -O1 -g",
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -fuse-ld=lld -fsanitize=address",
                "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -fuse-ld=lld -fsanitize=address"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-asan",
            "configurePreset": "linux-asan"
        }
    ],
    "testPresets": [
        {
            "name": "base-tests",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        },
        {
            "name": "windows-debug-tests",
            "displayName": "Run all tests (Windows Debug)",
            "description": "Run all Catch2 tests built with the windows-debug preset",
            "inherits": "base-tests",
            "configurePreset": "windows-debug",
            "filter": {
                "include": {
                    "name": ".*"
                }
            }
        },
        {
            "name": "linux-debug-tests",
            "displayName": "Run all tests (Linux Debug)",
            "description": "Run all Catch2 tests built with the linux-debug preset",
            "inherits": "base-tests",
            "configurePreset": "linux-debug",
            "filter": {
                "include": {
                    "name": ".*"
                }
            }
        }
    ]
}